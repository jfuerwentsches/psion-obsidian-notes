INCLUDE "const.oph"

REM PsiVault - Obsidian-light fuer den Psion 5mx (Phase 2: Browser + Viewer + Wikilinks)
REM Quelltext bewusst ASCII; Umlaute in UI-Texten ueber CHR$.
REM Temporary development UID; replace before public distribution.
APP PsiVault, &0F015105
  CAPTION "PsiVault", KLangEnglish%
  CAPTION "PsiVault", KLangGerman%
  REM Pfad relativ zum Arbeitsverzeichnis von compile.lua (build.sh wechselt nach app/src)
  ICON "../icon/PsiVault.mbm"
ENDA

CONST KRoot$="C:\Vault"
CONST KMaxIdx%=300
CONST KMaxEnt%=200
CONST KMaxLn%=4000
CONST KMaxLk%=40
CONST KMaxBk%=20
CONST KScrW%=640
CONST KScrH%=240
CONST KTitleH%=18
CONST KMargin%=8
CONST KCtrlD%=4
CONST KCtrlE%=5
CONST KCtrlF%=6
CONST KCtrlN%=14
CONST KCtrlR%=18
CONST KCtrlW%=23
CONST KMaxRs%=60
REM Seitenleisten-Lupen: am Geraet ermittelt. Sie erzeugen nur Key-Down/-Up-Ereignisse
REM mit diesen Scancodes in ev&(3), keinen Tastencode (Menue-Icon: Tastencode 10000).
CONST KZoomIn%=10003
CONST KZoomOut%=10004
CONST KState$="C:\System\Apps\PsiVault\state.txt"
CONST KEditMax%=30000
CONST KEditRes%=2000
CONST KMaxTb%=20
CONST KMaxTc%=8
CONST KMaxColW%=240

REM Zeilentypen des Viewers
CONST KTText%=0
CONST KTH1%=1
CONST KTH2%=2
CONST KTH3%=3
CONST KTCode%=4
CONST KTQuote%=5
CONST KTRule%=6
CONST KTFront%=7
CONST KTList%=8
CONST KTListC%=9
CONST KTTable%=10

REM OPL erlaubt max. 64 KB Variablen je Prozedur; die Globals sind deshalb
REM auf main -> init2 -> run verteilt.
PROC main:
  GLOBAL ix$(300,120), ixn%
  GLOBAL ent$(200,120), entdir%(200), entn%
  init2:
ENDP

PROC init2:
  GLOBAL entd$(200,80)
  GLOBAL lo&(4000), ll%(4000), lt%(4000), lx%(4000), ln%
  run:
ENDP

PROC run:
  GLOBAL cur$(120)
  GLOBAL buf&, bufsz&
  GLOBAL lk$(40,120), lkx%(40), lky%(40), lkw%(40), lkh%(40), lkn%, lksel%
  GLOBAL bk$(20,120), bkt%(20), bkn%
  GLOBAL vtop%, vpage%
  GLOBAL lpos&, lcont%, ltyp%, lind%, lcode%, lfm%, ltab%, lhdr%
  GLOBAL ev&(16), kmod%, penx%, peny%
  GLOBAL tcw%(160), tcn%(20), tbn%
  GLOBAL rs$(60,120), rc$(60,100), rd$(60,60), rn%, q$(40), autoed%
  GLOBAL wcnt&, meta$(60), zoom%
  LOCAL f$(120)
  buf&=0 : autoed%=0 : zoom%=1
  bldidx:
  cur$=KRoot$
  loadst:
  REM Mit Dokument gestartet: direkt anzeigen
  IF CMD$(3)="O"
    f$=CMD$(2)
    IF LOWER$(RIGHT$(f$,3))=".md" : view:(f$) : ENDIF
  ENDIF
  DO
    f$=browse$:
    IF f$<>"" : view:(f$) : ENDIF
  UNTIL f$=""
ENDP

REM ---------------------------------------------------------------- Index

REM Nutzt ent$ als Zwischenspeicher fuer die Namen eines Ordners (DIR$ darf
REM waehrend der Iteration nicht verschachtelt aufgerufen werden).
PROC bldidx:
  LOCAL st$(30,120), sp%, d$(120), n$(255), i%
  BUSY "Lese Vault..."
  ixn%=0
  sp%=1 : st$(1)=KRoot$
  WHILE sp%>0
    d$=st$(sp%) : sp%=sp%-1
    entn%=0
    n$=DIR$(d$+"\*")
    WHILE n$<>"" AND entn%<KMaxEnt%
      IF LOC(n$,"\")=0 : n$=d$+"\"+n$ : ENDIF
      entn%=entn%+1 : ent$(entn%)=LEFT$(n$,120)
      n$=DIR$("")
    ENDWH
    i%=1
    WHILE i%<=entn%
      n$=ent$(i%)
      IF RIGHT$(n$,1)="\"
        IF sp%<30 : sp%=sp%+1 : st$(sp%)=LEFT$(n$,LEN(n$)-1) : ENDIF
      ELSEIF LOWER$(RIGHT$(n$,3))=".md"
        IF ixn%<KMaxIdx% : ixn%=ixn%+1 : ix$(ixn%)=n$ : ENDIF
      ELSEIF LEFT$(base$:(n$),10)<>"_psionsync"
        REM Geraet und Emulator liefern Ordner OHNE Backslash: per DIR$ pruefen
        IF isdir%:(n$)
          IF sp%<30 : sp%=sp%+1 : st$(sp%)=n$ : ENDIF
        ENDIF
      ENDIF
      i%=i%+1
    ENDWH
  ENDWH
  BUSY OFF
ENDP

REM Ist p$ ein (nicht leerer) Ordner? DIR$ auf eine Datei loest im Emulator einen Fehler aus.
PROC isdir%:(p$)
  LOCAL r$(255)
  ONERR nodir::
  r$=DIR$(p$+"\*")
  ONERR OFF
  RETURN r$<>""
nodir::
  ONERR OFF
  RETURN 0
ENDP

REM Dateiname ohne Pfad und ohne .md
REM Parameter werden nie direkt beschrieben: am Geraet ist ihre Maximallaenge
REM die Laenge des uebergebenen Werts ("String zu lang").
PROC base$:(p$)
  LOCAL i%, k%, r$(255)
  i%=1 : k%=0
  WHILE i%<=LEN(p$)
    IF MID$(p$,i%,1)="\" : k%=i% : ENDIF
    i%=i%+1
  ENDWH
  r$=MID$(p$,k%+1,255)
  IF LOWER$(RIGHT$(r$,3))=".md" : r$=LEFT$(r$,LEN(r$)-3) : ENDIF
  RETURN r$
ENDP

REM Wikilink-Ziel aufloesen: Dateiname (ohne .md) gegen den Index, sonst Pfad
PROC resolve$:(tp$)
  LOCAL i%, h%, l$(120), b$(120), t$(255)
  t$=tp$
  h%=LOC(t$,"#") : IF h%>0 : t$=LEFT$(t$,h%-1) : ENDIF
  h%=LOC(t$,"|") : IF h%>0 : t$=LEFT$(t$,h%-1) : ENDIF
  WHILE LEFT$(t$,1)=" " : t$=MID$(t$,2,255) : ENDWH
  WHILE RIGHT$(t$,1)=" " : t$=LEFT$(t$,LEN(t$)-1) : ENDWH
  IF LOWER$(RIGHT$(t$,3))=".md" : t$=LEFT$(t$,LEN(t$)-3) : ENDIF
  IF t$="" : RETURN "" : ENDIF
  l$=LOWER$(t$)
  i%=1
  WHILE i%<=ixn%
    IF LOWER$(base$:(ix$(i%)))=l$ : RETURN ix$(i%) : ENDIF
    i%=i%+1
  ENDWH
  REM Pfadangabe wie Ordner/Notiz
  b$=""
  i%=1
  WHILE i%<=LEN(l$)
    IF MID$(l$,i%,1)="/" : b$=b$+"\" : ELSE : b$=b$+MID$(l$,i%,1) : ENDIF
    i%=i%+1
  ENDWH
  b$=LOWER$(KRoot$)+"\"+b$+".md"
  i%=1
  WHILE i%<=ixn%
    IF LOWER$(ix$(i%))=b$ : RETURN ix$(i%) : ENDIF
    i%=i%+1
  ENDWH
  RETURN ""
ENDP

REM ---------------------------------------------------------------- Ereignisse

REM Wartet auf ein Ereignis. Liefert einen Tastencode (16-Bit-Konventionen:
REM Pfeile 256.., Menue KGetMenu%), -1 fuer Stift-Tipp (penx%/peny%), 0 sonst.
PROC evkey%:
  LOCAL t&
  GETEVENT32 ev&()
  t&=ev&(1)
  IF t&=KEvPtr&
    IF ev&(4)=KEvPtrPenDown& : penx%=ev&(6) : peny%=ev&(7) : RETURN -1 : ENDIF
    RETURN 0
  ELSEIF t&=KEvCommand&
    IF CMD$(3)="X" : quit: : ENDIF
    RETURN 0
  ELSEIF t&=KEvKeyDown&
    REM Seitenleisten-Lupen kommen nur als Key-Down mit Scancode
    IF ev&(3)=KZoomIn% OR ev&(3)=KZoomOut% : RETURN ev&(3) : ENDIF
    RETURN 0
  ELSEIF t&=KEvKeyUp&
    RETURN 0
  ELSEIF t&>=KEvFocusGained& AND t&<=KEvPtrExit&
    REM Fokus-, Einschalt-, Datums-Ereignisse: ignorieren.
    REM (Nicht "t& AND KEvNotKeyMask&": Seitenleisten-Codes wie 10000 haben Bit &400 gesetzt.)
    RETURN 0
  ENDIF
  kmod%=ev&(4)
  IF t&=KKeyUpArrow32% : RETURN KKeyUpArrow% : ENDIF
  IF t&=KKeyDownArrow32% : RETURN KKeyDownArrow% : ENDIF
  IF t&=KKeyLeftArrow32% : RETURN KKeyLeftArrow% : ENDIF
  IF t&=KKeyRightArrow32% : RETURN KKeyRightArrow% : ENDIF
  IF t&=KKeyPageUp32% : RETURN KKeyPageUp% : ENDIF
  IF t&=KKeyPageDown32% : RETURN KKeyPageDown% : ENDIF
  IF t&=KKeyPageLeft32% : RETURN KKeyPageLeft% : ENDIF
  IF t&=KKeyPageRight32% : RETURN KKeyPageRight% : ENDIF
  IF t&=KKeyMenu32% OR t&=KKeySidebarMenu32% : RETURN KGetMenu% : ENDIF
  IF t&>255 : RETURN 0 : ENDIF
  RETURN t&
ENDP

PROC quit:
  savest:
  STOP
ENDP

REM Zeilenhoehe der Listen (Browser, Trefferliste) je Zoomstufe
PROC rowh%:
  RETURN fsize%:(KTText%)+3
ENDP

REM Zoomstufe 0..3 setzen und Notiz neu umbrechen
PROC setzoom:(z%)
  IF z%<0 : z%=0 : ENDIF
  IF z%>3 : z%=3 : ENDIF
  IF z%=zoom% : RETURN : ENDIF
  zoom%=z%
  savest:
  IF bufsz&>0
    BUSY "Layout..."
    layout:
    laymore:(vtop%+vpage%)
    IF vtop%>ln% : vtop%=ln% : ENDIF
    BUSY OFF
  ENDIF
ENDP

REM Letzte Position (aktueller Ordner) in KState$ sichern/laden
PROC savest:
  LOCAL h%, r%, s$(4)
  r%=IOOPEN(h%,KState$,KIoOpenModeReplace% OR KIoOpenFormatText% OR KIoOpenAccessUpdate%)
  IF r%<0 : RETURN : ENDIF
  IOWRITE(h%,ADDR(cur$)+1,LEN(cur$))
  s$=NUM$(zoom%,1)
  IOWRITE(h%,ADDR(s$)+1,LEN(s$))
  IOCLOSE(h%)
ENDP

PROC loadst:
  LOCAL h%, r%, s$(255), i%, z$(4), z%
  r%=IOOPEN(h%,KState$,KIoOpenModeOpen% OR KIoOpenFormatText%)
  IF r%<0 : RETURN : ENDIF
  r%=IOREAD(h%,ADDR(s$)+1,255)
  IF r%>0
    POKEB ADDR(s$),r%
    z%=IOREAD(h%,ADDR(z$)+1,4)
    IF z%>0 : POKEB ADDR(z$),z% : zoom%=VAL(z$) : IF zoom%<0 OR zoom%>3 : zoom%=1 : ENDIF : ENDIF
  ENDIF
  IOCLOSE(h%)
  IF r%<=0 : RETURN : ENDIF
  IF LEFT$(s$,LEN(KRoot$))<>KRoot$ : RETURN : ENDIF
  REM Ordner nur uebernehmen, wenn er noch Notizen enthaelt
  i%=1
  WHILE i%<=ixn%
    IF LEFT$(ix$(i%),LEN(s$)+1)=s$+"\" : cur$=LEFT$(s$,120) : RETURN : ENDIF
    i%=i%+1
  ENDWH
ENDP

REM ---------------------------------------------------------------- Browser

REM Eintraege des Ordners cur$ aus dem Index ableiten (Ordner zuerst, sortiert)
PROC lsdir:
  LOCAL i%, j%, p$(121), r$(120), n$(120), s%, isd%
  entn%=0
  p$=cur$+"\"
  i%=1
  WHILE i%<=ixn%
    IF LEFT$(ix$(i%),LEN(p$))=p$
      r$=MID$(ix$(i%),LEN(p$)+1,255)
      s%=LOC(r$,"\")
      IF s%>0
        n$=LEFT$(r$,s%-1) : isd%=-1
      ELSE
        n$=base$:(r$) : isd%=0
      ENDIF
      REM Duplikate (Ordner) vermeiden
      j%=1
      WHILE j%<=entn%
        IF entdir%(j%)=isd% AND entd$(j%)=n$ : BREAK : ENDIF
        j%=j%+1
      ENDWH
      IF j%>entn% AND entn%<KMaxEnt%
        entn%=entn%+1
        entd$(entn%)=n$ : entdir%(entn%)=isd%
        IF isd% : ent$(entn%)=p$+n$ : ELSE : ent$(entn%)=ix$(i%) : ENDIF
      ENDIF
    ENDIF
    i%=i%+1
  ENDWH
  sortent:
ENDP

PROC entlt%:(a%,b%)
  IF entdir%(a%)<>entdir%(b%) : RETURN entdir%(a%)<entdir%(b%) : ENDIF
  RETURN LOWER$(entd$(a%))<LOWER$(entd$(b%))
ENDP

PROC swapent:(a%,b%)
  LOCAL t$(120), td$(80), ti%
  t$=ent$(a%) : ent$(a%)=ent$(b%) : ent$(b%)=t$
  td$=entd$(a%) : entd$(a%)=entd$(b%) : entd$(b%)=td$
  ti%=entdir%(a%) : entdir%(a%)=entdir%(b%) : entdir%(b%)=ti%
ENDP

PROC sortent:
  LOCAL i%, j%
  i%=2
  WHILE i%<=entn%
    j%=i%
    WHILE j%>1
      IF entlt%:(j%,j%-1) : swapent:(j%,j%-1) : ELSE : BREAK : ENDIF
      j%=j%-1
    ENDWH
    i%=i%+1
  ENDWH
ENDP

PROC title:(t$)
  title2:(t$,"")
ENDP

REM Titelzeile mit rechtsbuendigem Zusatztext (Metadaten)
PROC title2:(t$,r$)
  LOCAL w%
  gFONT KFontArialNormal13&
  gSTYLE 1
  gAT 0,0 : gFILL KScrW%,KTitleH%,1
  gAT KMargin%,13 : gPRINT t$
  IF r$<>""
    gSTYLE 0
    w%=gTWIDTH(r$)
    gAT KScrW%-KMargin%-w%,13 : gPRINT r$
  ENDIF
  gAT 0,0 : gFILL KScrW%,KTitleH%,2
  gSTYLE 0
ENDP

PROC drawlist:(sel%,top%,rows%)
  LOCAL i%, y%, d$(120)
  gUPDATE OFF
  gCLS
  d$=MID$(cur$,LEN(KRoot$)+1,255)
  IF d$="" : d$="\" : ENDIF
  title:("PsiVault  " + d$ + "   (" + NUM$(entn%,5) + ")")
  setfont:(KTText%)
  i%=top%
  y%=KTitleH%+2
  WHILE i%<=entn% AND i%<top%+rows%
    IF entdir%(i%) : gSTYLE 1 : ELSE : gSTYLE 0 : ENDIF
    gAT KMargin%+4,y%+ascent%:(KTText%)
    IF entdir%(i%) : gPRINT entd$(i%)+"\" : ELSE : gPRINT entd$(i%) : ENDIF
    IF i%=sel% : gAT 0,y% : gFILL KScrW%,rowh%:,2 : ENDIF
    y%=y%+rowh%:
    i%=i%+1
  ENDWH
  gSTYLE 0
  IF entn%=0
    gAT KMargin%+4,y%+ascent%:(KTText%) : gPRINT "(leer)"
  ENDIF
  gUPDATE ON
  gUPDATE
ENDP

REM Liefert den gewaehlten Dateipfad oder "" zum Beenden
PROC browse$:
  LOCAL sel%, top%, rows%, k%, came$(120), i%, dirty%, skip%, t$(120)
  lsdir:
  sel%=1 : top%=1 : dirty%=-1 : skip%=0
  WHILE 1
    rows%=(KScrH%-KTitleH%-2)/rowh%:
    IF sel%>entn% : sel%=entn% : ENDIF
    IF sel%<1 : sel%=1 : ENDIF
    IF sel%<top% : top%=sel% : ENDIF
    IF sel%>=top%+rows% : top%=sel%-rows%+1 : ENDIF
    REM Nur zeichnen, wenn noetig; bei gestapelten Ereignissen (Taste gehalten) zusammenfassen
    IF dirty%
      IF skip%>=4 OR NOT TESTEVENT
        drawlist:(sel%,top%,rows%) : dirty%=0 : skip%=0
      ELSE
        skip%=skip%+1
      ENDIF
    ENDIF
    k%=evkey%:
    IF k%=0 : CONTINUE : ENDIF
    dirty%=-1
    IF k%=-1
      REM Stift: Titelzeile = Ebene hoch, Zeile = waehlen, gewaehlte Zeile = oeffnen
      IF peny%<KTitleH%
        k%=KKeyEsc%
      ELSE
        i%=top%+(peny%-KTitleH%-2)/rowh%:
        IF i%>=1 AND i%<=entn%
          IF i%=sel% : k%=KKeyEnter% : ELSE : sel%=i% : ENDIF
        ENDIF
      ENDIF
    ENDIF
    IF k%=KCtrlE%
      quit:
    ELSEIF k%=KZoomIn% OR k%=43 : setzoom:(zoom%+1)
    ELSEIF k%=KZoomOut% OR k%=45 : setzoom:(zoom%-1)
    ELSEIF k%=KKeyDownArrow% : sel%=sel%+1
    ELSEIF k%=KKeyUpArrow% : sel%=sel%-1
    ELSEIF k%=KKeyPageDown% : sel%=sel%+rows%-1
    ELSEIF k%=KKeyPageUp% : sel%=sel%-rows%+1
    ELSEIF k%=KKeyPageLeft% : sel%=1
    ELSEIF k%=KKeyPageRight% : sel%=entn%
    ELSEIF k%=KKeyEnter% OR k%=KKeyRightArrow%
      IF entn%>0
        IF entdir%(sel%)
          cur$=ent$(sel%) : lsdir: : sel%=1 : top%=1
        ELSE
          RETURN ent$(sel%)
        ENDIF
      ENDIF
    ELSEIF k%=KKeyEsc% OR k%=KKeyDel% OR k%=KKeyLeftArrow%
      IF cur$<>KRoot$
        came$=cur$
        i%=LEN(cur$)
        WHILE i%>0 AND MID$(cur$,i%,1)<>"\" : i%=i%-1 : ENDWH
        cur$=LEFT$(cur$,i%-1)
        lsdir:
        sel%=1 : top%=1
        i%=1
        WHILE i%<=entn%
          IF ent$(i%)=came$ : sel%=i% : BREAK : ENDIF
          i%=i%+1
        ENDWH
      ENDIF
    ELSEIF k%=KCtrlR%
      bldidx: : lsdir: : sel%=1 : top%=1
    ELSEIF k%=KCtrlF%
      t$=search$:
      IF t$<>"" : RETURN t$ : ENDIF
    ELSEIF k%=KCtrlN%
      t$=newnote$:
      IF t$<>"" : RETURN t$ : ENDIF
    ELSEIF k%=KCtrlD%
      IF entn%>0
        IF entdir%(sel%)=0
          IF delnote%:(ent$(sel%)) : lsdir: : ENDIF
        ENDIF
      ENDIF
    ELSEIF k%=KGetMenu%
      k%=menu%:(0)
      IF k%=%e : quit: : ENDIF
      IF k%=%i : setzoom:(zoom%+1) : ENDIF
      IF k%=%k : setzoom:(zoom%-1) : ENDIF
      IF k%=%r : bldidx: : lsdir: : sel%=1 : top%=1 : ENDIF
      IF k%=%f : t$=search$: : IF t$<>"" : RETURN t$ : ENDIF : ENDIF
      IF k%=%n : t$=newnote$: : IF t$<>"" : RETURN t$ : ENDIF : ENDIF
      IF k%=%d AND entn%>0
        IF entdir%(sel%)=0
          IF delnote%:(ent$(sel%)) : lsdir: : ENDIF
        ENDIF
      ENDIF
    ENDIF
  ENDWH
ENDP

REM Menue; inview%: Notiz-Befehle aktiv. Rueckgabe = Kurztaste (%w, %e, ...)
PROC menu%:(inview%)
  LOCAL d%
  d%=0
  IF inview%=0 : d%=KMenuDimmed% : ENDIF
  mINIT
  mCARD "Datei", "Neue Notiz", %n, "Volltextsuche", %f, "Index neu aufbauen", %r, "Beenden", %e
  mCARD "Notiz", "Bearbeiten", %b OR d%, "Schlie"+CHR$(223)+"en", %w OR d%, "L"+CHR$(246)+"schen", %d
  mCARD "Ansicht", "Gr"+CHR$(246)+CHR$(223)+"er", %i, "Kleiner", %k
  RETURN MENU
ENDP

REM ---------------------------------------------------------------- Metadaten

REM Woerter im Dateipuffer zaehlen: Segmente zwischen Leerzeichen/Zeilenenden,
REM per LOC statt Byte-Schleife (OPL-Schleifen sind am Geraet zu langsam)
PROC words&:
  LOCAL pos&, s$(255), r$(255), p1%, p2%, p%, n&, carry%, i%
  n&=0 : carry%=0 : pos&=0
  WHILE pos&<bufsz&
    s$=peekat$:(pos&,255) : pos&=pos&+LEN(s$)
    i%=1
    WHILE i%<=LEN(s$)
      r$=MID$(s$,i%,255)
      p%=LOC(r$," ")
      p2%=LOC(r$,CHR$(10)) : IF p2%>0 AND (p%=0 OR p2%<p%) : p%=p2% : ENDIF
      p2%=LOC(r$,CHR$(13)) : IF p2%>0 AND (p%=0 OR p2%<p%) : p%=p2% : ENDIF
      p2%=LOC(r$,CHR$(9)) : IF p2%>0 AND (p%=0 OR p2%<p%) : p%=p2% : ENDIF
      IF p%=0
        REM Rest ohne Trenner: zaehlt, laeuft evtl. im naechsten Block weiter
        IF LEN(r$)>0 AND carry%=0 : n&=n&+1 : ENDIF
        carry%=-1
        BREAK
      ENDIF
      IF p%>1 AND carry%=0 : n&=n&+1 : ENDIF
      carry%=0
      i%=i%+p%
    ENDWH
    IF i%>LEN(s$) : carry%=0 : ENDIF
  ENDWH
  RETURN n&
ENDP

PROC size$:(b&)
  IF b&<1000 : RETURN trim$:(NUM$(b&,6))+" B" : ENDIF
  IF b&<100000 : RETURN trim$:(NUM$(b&/1000,4))+","+trim$:(NUM$((b&/100)-(b&/1000)*10,1))+" KB" : ENDIF
  RETURN trim$:(NUM$(b&/1000,6))+" KB"
ENDP

REM Metadaten-Text der geladenen Notiz, z.B. "1,2 KB  |  187 W" + CHR$(246) + "rter".
REM exact%=0: bei grossen Notizen nur schaetzen (Zaehlung kostet am Geraet Zeit)
PROC mkmeta:(exact%)
  LOCAL w$(20)
  IF exact% OR bufsz&<=12000
    wcnt&=words&:
    w$=trim$:(NUM$(wcnt&,7))
  ELSE
    wcnt&=bufsz&/8
    w$="~"+trim$:(NUM$(wcnt&,7))
  ENDIF
  meta$=size$:(bufsz&)+"  |  "+w$+" W"+CHR$(246)+"rter"
ENDP

REM ---------------------------------------------------------------- Suche / Anlegen / Loeschen

REM Erste Fundstelle von q$ im Dateipuffer (Offset, -1 = keine); LOC ist nicht case-sensitiv
PROC find&:(q$)
  LOCAL pos&, s$(255), p%, step%
  step%=255-LEN(q$)+1
  pos&=0
  WHILE pos&<bufsz&
    s$=peekat$:(pos&,255)
    p%=LOC(s$,q$)
    IF p%>0 : RETURN pos&+p%-1 : ENDIF
    IF LEN(s$)<255 : RETURN -1 : ENDIF
    pos&=pos&+step%
  ENDWH
  RETURN -1
ENDP

REM Zeile um Offset off& als Kontext (max. 100 Zeichen)
PROC ctx$:(off&)
  LOCAL st&, s$(255), nl%
  st&=lstart&:(off&)
  IF PEEKB(buf&+st&)=10 : st&=st&+1 : ENDIF
  s$=peekat$:(st&,200)
  nl%=LOC(s$,CHR$(13))
  IF nl%>0 : s$=LEFT$(s$,nl%-1) : ENDIF
  RETURN LEFT$(trim$:(s$),100)
ENDP

REM Volltextsuche ueber alle Notizen; liefert gewaehlten Pfad oder ""
PROC search$:
  LOCAL i%, off&, k%, sel%, top%, rows%, dirty%, skip%, y%, w%
  dINIT "Volltextsuche"
  dEDIT q$,"Suchen nach",24
  IF DIALOG=0 : RETURN "" : ENDIF
  q$=trim$:(q$)
  IF q$="" : RETURN "" : ENDIF
  BUSY "Suche..."
  rn%=0
  i%=1
  WHILE i%<=ixn% AND rn%<KMaxRs%
    IF load%:(ix$(i%))=0
      off&=find&:(q$)
      IF off&>=0
        rn%=rn%+1 : rs$(rn%)=ix$(i%) : rc$(rn%)=ctx$:(off&)
      ENDIF
    ENDIF
    i%=i%+1
  ENDWH
  BUSY OFF
  IF rn%=0
    ALERT("Keine Treffer f"+CHR$(252)+"r",q$)
    RETURN ""
  ENDIF
  REM Anzeige-Strings einmal kuerzen (gTWIDTH ist beim Zeichnen zu teuer)
  setfont:(KTText%)
  i%=1
  WHILE i%<=rn%
    gSTYLE 1 : rd$(i%)=LEFT$(trunc$:(base$:(rs$(i%)),220,KTText%),60) : gSTYLE 0
    rc$(i%)=trunc$:(rc$(i%),KScrW%-KMargin%-250,KTText%)
    i%=i%+1
  ENDWH
  sel%=1 : top%=1 : dirty%=-1 : skip%=0
  WHILE 1
    rows%=(KScrH%-KTitleH%-2)/rowh%:
    IF sel%<1 : sel%=1 : ENDIF
    IF sel%>rn% : sel%=rn% : ENDIF
    IF sel%<top% : top%=sel% : ENDIF
    IF sel%>=top%+rows% : top%=sel%-rows%+1 : ENDIF
    IF dirty%
      IF skip%>=4 OR NOT TESTEVENT
        gUPDATE OFF
        gCLS
        title:("Suche: "+q$+"   ("+NUM$(rn%,3)+" Treffer)")
        i%=top% : y%=KTitleH%+2
        WHILE i%<=rn% AND i%<top%+rows%
          setfont:(KTText%) : gSTYLE 1
          gAT KMargin%+4,y%+ascent%:(KTText%) : gPRINT rd$(i%)
          gSTYLE 0
          gAT KMargin%+236,y%+ascent%:(KTText%) : gPRINT rc$(i%)
          IF i%=sel% : gAT 0,y% : gFILL KScrW%,rowh%:,2 : ENDIF
          y%=y%+rowh%: : i%=i%+1
        ENDWH
        gUPDATE ON
        gUPDATE
        dirty%=0 : skip%=0
      ELSE
        skip%=skip%+1
      ENDIF
    ENDIF
    k%=evkey%:
    IF k%=0 : CONTINUE : ENDIF
    dirty%=-1
    IF k%=-1
      IF peny%<KTitleH%
        k%=KKeyEsc%
      ELSE
        i%=top%+(peny%-KTitleH%-2)/rowh%:
        IF i%>=1 AND i%<=rn%
          IF i%=sel% : k%=KKeyEnter% : ELSE : sel%=i% : ENDIF
        ENDIF
      ENDIF
    ENDIF
    IF k%=KKeyDownArrow% : sel%=sel%+1
    ELSEIF k%=KKeyUpArrow% : sel%=sel%-1
    ELSEIF k%=KKeyPageDown% : sel%=sel%+rows%-1
    ELSEIF k%=KKeyPageUp% : sel%=sel%-rows%+1
    ELSEIF k%=KKeyPageLeft% : sel%=1
    ELSEIF k%=KKeyPageRight% : sel%=rn%
    ELSEIF k%=KKeyEnter% OR k%=KKeyRightArrow%
      RETURN rs$(sel%)
    ELSEIF k%=KKeyEsc% OR k%=KKeyDel% OR k%=KKeyLeftArrow% OR k%=KCtrlW%
      RETURN ""
    ELSEIF k%=KZoomIn% OR k%=43 : setzoom:(zoom%+1)
    ELSEIF k%=KZoomOut% OR k%=45 : setzoom:(zoom%-1)
    ELSEIF k%=KCtrlE%
      quit:
    ENDIF
  ENDWH
ENDP

REM Neue Notiz im aktuellen Ordner anlegen; liefert Pfad oder ""
PROC newnote$:
  LOCAL n$(80), f$(120), h%, r%, i%, c$(1), s$(255)
  n$=""
  s$=MID$(cur$,LEN(KRoot$)+1,255)+"\"
  IF LEN(s$)>36 : s$=CHR$(133)+RIGHT$(s$,35) : ENDIF
  dINIT "Neue Notiz"
  dTEXT "","Ordner: "+s$,KDTextLeft%
  dEDIT n$,"Name",30
  IF DIALOG=0 : RETURN "" : ENDIF
  n$=trim$:(n$)
  IF n$="" : RETURN "" : ENDIF
  i%=1
  WHILE i%<=LEN(n$)
    c$=MID$(n$,i%,1)
    IF LOC("\/:*?"+CHR$(34)+"<>|",c$)>0
      ALERT("Unerlaubtes Zeichen im Namen: "+c$)
      RETURN ""
    ENDIF
    i%=i%+1
  ENDWH
  IF LOWER$(RIGHT$(n$,3))=".md" : n$=LEFT$(n$,LEN(n$)-3) : ENDIF
  f$=cur$+"\"+n$+".md"
  IF LEN(f$)>120 : ALERT("Name zu lang") : RETURN "" : ENDIF
  IF EXIST(f$) : ALERT("Notiz existiert schon",n$) : RETURN "" : ENDIF
  r%=IOOPEN(h%,f$,KIoOpenModeCreate% OR KIoOpenFormatBinary% OR KIoOpenAccessUpdate%)
  IF r%<0 : ALERT("Anlegen fehlgeschlagen",ERR$(r%)) : RETURN "" : ENDIF
  s$="# "+n$+CHR$(13)+CHR$(10)+CHR$(13)+CHR$(10)
  IOWRITE(h%,ADDR(s$)+1,LEN(s$))
  IOCLOSE(h%)
  IF ixn%<KMaxIdx% : ixn%=ixn%+1 : ix$(ixn%)=f$ : ELSE : bldidx: : ENDIF
  autoed%=-1
  RETURN f$
ENDP

REM Notiz nach Rueckfrage loeschen; -1 wenn geloescht
PROC delnote%:(f$)
  LOCAL i%
  dINIT "Notiz l"+CHR$(246)+"schen?"
  dTEXT "",base$:(f$),KDTextCentre%
  dBUTTONS "Nein",-KDButtonEsc%,"L"+CHR$(246)+"schen",%l
  IF DIALOG<>%l : RETURN 0 : ENDIF
  TRAP DELETE f$
  IF ERR<0 : ALERT("L"+CHR$(246)+"schen fehlgeschlagen",ERR$(ERR)) : RETURN 0 : ENDIF
  i%=1
  WHILE i%<=ixn%
    IF ix$(i%)=f$
      WHILE i%<ixn% : ix$(i%)=ix$(i%+1) : i%=i%+1 : ENDWH
      ixn%=ixn%-1
      BREAK
    ENDIF
    i%=i%+1
  ENDWH
  RETURN -1
ENDP

REM ---------------------------------------------------------------- Editor

REM Anfang der Quellzeile, in der off& liegt
PROC lstart&:(off&)
  WHILE off&>0
    IF PEEKB(buf&+off&)=10 : RETURN off& : ENDIF
    off&=off&-1
  ENDWH
  RETURN 0
ENDP

REM Letztes Zeilenende (nach LF) vor oder bei off&
PROC lend&:(off&)
  WHILE off&>0
    IF PEEKB(buf&+off&)=10 : RETURN off& : ENDIF
    off&=off&-1
  ENDWH
  RETURN 0
ENDP

REM Rohdaten eines Strings an addr& schreiben (ohne Laengenbyte)
PROC pokeraw:(addr&,s$)
  LOCAL sv%
  IF LEN(s$)=0 : RETURN : ENDIF
  sv%=PEEKB(addr&-1)
  POKE$ addr&-1,s$
  POKEB addr&-1,sv%
ENDP

REM Bereich [st&,en&) des Dateipuffers in den Editorpuffer kopieren, CRLF -> CHR$(6)
PROC toedit&:(eb&,st&,en&)
  LOCAL pos&, n&, s$(255), c%, p%
  pos&=st& : n&=0
  WHILE pos&<en&
    c%=255
    IF en&-pos&<c% : c%=en&-pos& : ENDIF
    s$=peekat$:(pos&,c%)
    IF RIGHT$(s$,1)=CHR$(13) AND LEN(s$)>1 AND pos&+LEN(s$)<en& : s$=LEFT$(s$,LEN(s$)-1) : ENDIF
    pos&=pos&+LEN(s$)
    p%=LOC(s$,CHR$(13)+CHR$(10))
    WHILE p%>0
      s$=LEFT$(s$,p%-1)+CHR$(6)+MID$(s$,p%+2,255)
      p%=LOC(s$,CHR$(13)+CHR$(10))
    ENDWH
    pokeraw:(eb&+4+n&,s$)
    n&=n&+LEN(s$)
  ENDWH
  RETURN n&
ENDP

REM Editorpuffer in Datei schreiben, CHR$(6)/(7)/(8) -> CRLF
PROC wredit%:(h%,eb&,len&)
  LOCAL pos&, s$(255), c%, i%, r%, ch$(1), crlf$(2)
  crlf$=CHR$(13)+CHR$(10)
  pos&=0
  WHILE pos&<len&
    c%=255
    IF len&-pos&<c% : c%=len&-pos& : ENDIF
    s$=peekraw$:(eb&+4+pos&,c%)
    pos&=pos&+LEN(s$)
    i%=1
    WHILE i%<=LEN(s$)
      ch$=MID$(s$,i%,1)
      IF ch$=CHR$(6) OR ch$=CHR$(7) OR ch$=CHR$(8)
        r%=IOWRITE(h%,ADDR(s$)+1,i%-1)
        IF r%<0 : RETURN r% : ENDIF
        r%=IOWRITE(h%,ADDR(crlf$)+1,2)
        IF r%<0 : RETURN r% : ENDIF
        s$=MID$(s$,i%+1,255) : i%=1
      ELSE
        i%=i%+1
      ENDIF
    ENDWH
    IF LEN(s$)>0
      r%=IOWRITE(h%,ADDR(s$)+1,LEN(s$))
      IF r%<0 : RETURN r% : ENDIF
    ENDIF
  ENDWH
  RETURN 0
ENDP

REM n% Rohbytes ab addr& als String
PROC peekraw$:(addr&,n%)
  LOCAL sv%, s$(255)
  IF n%<=0 : RETURN "" : ENDIF
  IF n%>255 : n%=255 : ENDIF
  sv%=PEEKB(addr&-1)
  POKEB addr&-1,n%
  s$=PEEK$(addr&-1)
  POKEB addr&-1,sv%
  RETURN s$
ENDP

REM Bereich des Dateipuffers roh schreiben
PROC wrbuf%:(h%,st&,en&)
  LOCAL n%, r%
  WHILE st&<en&
    n%=16384
    IF en&-st&<n% : n%=en&-st& : ENDIF
    r%=IOWRITE(h%,buf&+1+st&,n%)
    IF r%<0 : RETURN r% : ENDIF
    st&=st&+n%
  ENDWH
  RETURN 0
ENDP

REM Ist die Datei noch identisch mit dem geladenen Puffer?
PROC filesame%:(f$)
  LOCAL h%, r%, sz&, pos&, s$(255), n%
  r%=IOOPEN(h%,f$,KIoOpenModeOpen% OR KIoOpenFormatBinary% OR KIoOpenAccessRandom%)
  IF r%<0 : RETURN 0 : ENDIF
  sz&=0 : r%=IOSEEK(h%,2,sz&)
  IF sz&<>bufsz& : IOCLOSE(h%) : RETURN 0 : ENDIF
  pos&=0 : r%=IOSEEK(h%,1,pos&)
  WHILE pos&<sz&
    n%=255
    IF sz&-pos&<n% : n%=sz&-pos& : ENDIF
    r%=IOREAD(h%,ADDR(s$)+1,n%)
    IF r%<0 : IOCLOSE(h%) : RETURN 0 : ENDIF
    POKEB ADDR(s$),r%
    IF s$<>peekat$:(pos&,r%) : IOCLOSE(h%) : RETURN 0 : ENDIF
    pos&=pos&+r%
  ENDWH
  IOCLOSE(h%)
  RETURN -1
ENDP

REM Neue Fassung nach path$ schreiben: Puffer[0,st&) + Editor + Puffer[en&,Ende)
PROC savenew%:(path$,eb&,len&,st&,en&)
  LOCAL h%, r%
  r%=IOOPEN(h%,path$,KIoOpenModeReplace% OR KIoOpenFormatBinary% OR KIoOpenAccessUpdate%)
  IF r%<0 : RETURN r% : ENDIF
  r%=wrbuf%:(h%,0,st&)
  IF r%=0 : r%=wredit%:(h%,eb&,len&) : ENDIF
  IF r%=0 : r%=wrbuf%:(h%,en&,bufsz&) : ENDIF
  IOCLOSE(h%)
  RETURN r%
ENDP

REM Datei atomar ersetzen: neu -> .tmp, alt -> .bak, .tmp -> Name, .bak loeschen
PROC replace%:(f$,eb&,len&,st&,en&)
  LOCAL tmp$(130), bak$(130), r%
  tmp$=f$+".tmp" : bak$=f$+".bak"
  r%=savenew%:(tmp$,eb&,len&,st&,en&)
  IF r%<0 : RETURN r% : ENDIF
  IF EXIST(bak$) : TRAP DELETE bak$ : ENDIF
  TRAP RENAME f$,bak$
  IF ERR<0 : RETURN ERR : ENDIF
  TRAP RENAME tmp$,f$
  IF ERR<0
    r%=ERR
    TRAP RENAME bak$,f$
    RETURN r%
  ENDIF
  TRAP DELETE bak$
  RETURN 0
ENDP

PROC stamp$:
  RETURN NUM$(YEAR,4)+"-"+RIGHT$("0"+NUM$(MONTH,2),2)+"-"+RIGHT$("0"+NUM$(DAY,2),2)+" "+RIGHT$("0"+NUM$(HOUR,2),2)+RIGHT$("0"+NUM$(MINUTE,2),2)
ENDP

REM Notiz (oder Ausschnitt) in dEDITMULTI bearbeiten und speichern
PROC editnote:(f$)
  LOCAL eb&, st&, en&, n&, len&, k%, r%, t$(130), out$(130), part%
  IF bufsz&<=KEditMax%-KEditRes%
    st&=0 : en&=bufsz& : part%=0
  ELSE
    st&=lstart&:(lo&(vtop%))
    en&=st&+KEditMax%-KEditRes%
    IF en&>=bufsz& : en&=bufsz& : ELSE : en&=lend&:(en&) : ENDIF
    part%=-1
  ENDIF
  eb&=ALLOC(KEditMax%+4)
  IF eb&=0 : ALERT("Zu wenig Speicher zum Bearbeiten") : RETURN : ENDIF
  n&=toedit&:(eb&,st&,en&)
  POKEL eb&,n&
  mkmeta:(-1)
  t$=base$:(f$)
  IF part% : t$=LEFT$(t$,60)+" (Ausschnitt)" : ENDIF
  t$=LEFT$(t$,60)+"    "+meta$
  dINIT t$,KDlgFillScreen% OR KDlgButRight%
  dEDITMULTI eb&,"",72,8,KEditMax%
  dBUTTONS "Abbrechen",-KDButtonEsc%,"Speichern",%s
  k%=DIALOG
  IF k%=%s
    len&=PEEKL(eb&)
    IF n&>200 AND len&<n&/2
      REM Schutz: der Text ist beim Oeffnen komplett markiert, ein Tastendruck ersetzt alles
      dINIT "Text stark gek"+CHR$(252)+"rzt"
      dTEXT "",NUM$(n&,6)+" -> "+NUM$(len&,6)+" Zeichen. Trotzdem speichern?",KDTextCentre%
      dBUTTONS "Nein",-KDButtonEsc%,"Speichern",%s
      IF DIALOG<>%s : k%=0 : ENDIF
    ENDIF
  ENDIF
  IF k%=%s
    IF filesame%:(f$)
      r%=replace%:(f$,eb&,len&,st&,en&)
      IF r%<0 : ALERT("Speichern fehlgeschlagen",ERR$(r%)) : ENDIF
    ELSE
      out$=LEFT$(f$,LEN(f$)-3)+" (PsiVault "+stamp$:+").md"
      r%=savenew%:(out$,eb&,len&,st&,en&)
      IF r%<0
        ALERT("Speichern fehlgeschlagen",ERR$(r%))
      ELSE
        ALERT("Notiz wurde extern ge"+CHR$(228)+"ndert.","Deine Fassung: "+base$:(out$))
        bldidx:
      ENDIF
    ENDIF
    FREEALLOC eb&
    IF open%:(f$)<0 : RETURN : ENDIF
    laymore:(vtop%+vpage%)
    IF vtop%>ln% : vtop%=ln% : ENDIF
  ELSE
    FREEALLOC eb&
  ENDIF
ENDP

REM ---------------------------------------------------------------- Datei laden

REM Datei komplett in buf& laden (Daten ab buf&+1, Byte davor ist Platz fuer PEEK$-Laengenbyte)
PROC load%:(f$)
  LOCAL h%, r%, sz&, off&, n%
  IF buf&<>0 : FREEALLOC buf& : buf&=0 : ENDIF
  bufsz&=0
  r%=IOOPEN(h%,f$,KIoOpenModeOpen% OR KIoOpenFormatBinary% OR KIoOpenAccessRandom%)
  IF r%<0 : RETURN r% : ENDIF
  sz&=0
  r%=IOSEEK(h%,2,sz&)
  IF r%<0 : IOCLOSE(h%) : RETURN r% : ENDIF
  off&=0
  r%=IOSEEK(h%,1,off&)
  buf&=ALLOC(sz&+2)
  IF buf&=0 : IOCLOSE(h%) : RETURN -1 : ENDIF
  off&=0
  WHILE off&<sz&
    IF sz&-off&>16384 : n%=16384 : ELSE : n%=sz&-off& : ENDIF
    r%=IOREAD(h%,buf&+1+off&,n%)
    IF r%<0 : BREAK : ENDIF
    IF r%=0 : BREAK : ENDIF
    off&=off&+r%
  ENDWH
  IOCLOSE(h%)
  bufsz&=off&
  RETURN 0
ENDP

REM Bis zu n% Bytes ab Offset off& als String (ueber ein temporaeres Laengenbyte)
PROC peekat$:(off&,n%)
  LOCAL a&, sv%, s$(255)
  IF n%<=0 OR off&>=bufsz& : RETURN "" : ENDIF
  IF off&+n%>bufsz& : n%=bufsz&-off& : ENDIF
  IF n%>255 : n%=255 : ENDIF
  a&=buf&+off&
  sv%=PEEKB(a&)
  POKEB a&,n%
  s$=PEEK$(a&)
  POKEB a&,sv%
  RETURN s$
ENDP

REM Offset hinter dem naechsten Zeilenende ab pos& (Dateiende, falls keins).
REM Noetig fuer uebersprungene Zeilen laenger als das 255-Byte-Lesefenster.
PROC eol&:(pos&)
  LOCAL s$(255), nl%
  WHILE pos&<bufsz&
    s$=peekat$:(pos&,255)
    nl%=LOC(s$,CHR$(10))
    IF nl%>0 : RETURN pos&+nl% : ENDIF
    pos&=pos&+LEN(s$)
  ENDWH
  RETURN pos&
ENDP

REM ---------------------------------------------------------------- Layout

REM Schriftgroesse (Punkt) je Zeilentyp und Zoomstufe 0..3
PROC fsize%:(t%)
  IF t%=KTH1%
    IF zoom%=0 : RETURN 15 : ELSEIF zoom%=1 : RETURN 18 : ELSEIF zoom%=2 : RETURN 22 : ELSE : RETURN 27 : ENDIF
  ELSEIF t%=KTH2%
    IF zoom%=0 : RETURN 13 : ELSEIF zoom%=1 : RETURN 15 : ELSEIF zoom%=2 : RETURN 18 : ELSE : RETURN 22 : ENDIF
  ELSEIF t%=KTCode%
    IF zoom%=0 : RETURN 11 : ELSEIF zoom%=1 : RETURN 11 : ELSEIF zoom%=2 : RETURN 13 : ELSE : RETURN 15 : ENDIF
  ENDIF
  IF zoom%=0 : RETURN 11 : ELSEIF zoom%=1 : RETURN 13 : ELSEIF zoom%=2 : RETURN 15 : ELSE : RETURN 18 : ENDIF
ENDP

PROC arial&:(sz%)
  IF sz%<=11 : RETURN KFontArialNormal11& : ENDIF
  IF sz%=13 : RETURN KFontArialNormal13& : ENDIF
  IF sz%=15 : RETURN KFontArialNormal15& : ENDIF
  IF sz%=18 : RETURN KFontArialNormal18& : ENDIF
  IF sz%=22 : RETURN KFontArialNormal22& : ENDIF
  RETURN KFontArialNormal27&
ENDP

PROC courier&:(sz%)
  IF sz%<=11 : RETURN KFontCourierNormal11& : ENDIF
  IF sz%=13 : RETURN KFontCourierNormal13& : ENDIF
  RETURN KFontCourierNormal15&
ENDP

PROC setfont:(t%)
  IF t%=KTCode%
    gFONT courier&:(fsize%:(t%)) : gSTYLE 0
  ELSE
    gFONT arial&:(fsize%:(t%))
    IF t%=KTH1% OR t%=KTH2% OR t%=KTH3% : gSTYLE 1 : ELSE : gSTYLE 0 : ENDIF
  ENDIF
ENDP

PROC lineh%:(t%,len%)
  IF t%=KTRule% : RETURN 8 : ENDIF
  IF t%=KTText% AND len%=0 : RETURN fsize%:(t%)/2+2 : ENDIF
  IF t%=KTH1% : RETURN fsize%:(t%)+6 : ENDIF
  IF t%=KTH2% OR t%=KTH3% : RETURN fsize%:(t%)+5 : ENDIF
  RETURN fsize%:(t%)+3
ENDP

PROC ascent%:(t%)
  RETURN fsize%:(t%)
ENDP

REM Breite in Pixeln mit Inline-Auszeichnung: `Code` wird in Courier gemessen
PROC mw%:(sp$,t%)
  LOCAL w%, p%, code%, seg$(255), s$(255)
  IF t%=KTCode% OR LOC(sp$,"`")=0 : RETURN gTWIDTH(sp$) : ENDIF
  s$=sp$
  w%=0 : code%=0
  WHILE LEN(s$)>0
    p%=LOC(s$,"`")
    IF p%=0 : seg$=s$ : s$="" : ELSE : seg$=LEFT$(s$,p%-1) : s$=MID$(s$,p%+1,255) : ENDIF
    IF code% : gFONT courier&:(fsize%:(KTText%)) : gSTYLE 0 : ELSE : setfont:(t%) : ENDIF
    w%=w%+gTWIDTH(seg$)
    code%=NOT code%
  ENDWH
  setfont:(t%)
  RETURN w%
ENDP

REM Letztes Leerzeichen in s$ an Position <= p% (0 = keins)
PROC lastsp%:(s$,p%)
  WHILE p%>0
    IF MID$(s$,p%,1)=" " : RETURN p% : ENDIF
    p%=p%-1
  ENDWH
  RETURN 0
ENDP

REM Anzahl Zeichen von s$, die in avail% Pixel passen (Umbruch an Leerzeichen).
REM Schaetzt die Stelle proportional aus der Gesamtbreite und korrigiert dann.
PROC fit%:(s$,avail%,t%)
  LOCAL w%, p%, q%, n%
  w%=mw%:(s$,t%)
  IF w%<=avail% : RETURN LEN(s$) : ENDIF
  n%=LEN(s$)
  p%=INT(FLT(n%)*FLT(avail%)/FLT(w%))
  IF p%<1 : p%=1 : ENDIF
  q%=lastsp%:(s$,p%)
  IF q%=0
    REM kein Leerzeichen vor der Schaetzung: erstes Leerzeichen danach oder hart trennen
    q%=LOC(s$," ")
    IF q%>1
      IF mw%:(LEFT$(s$,q%-1),t%)>avail% : q%=0 : ENDIF
    ENDIF
    IF q%<=1
      REM OPL wertet OR nicht verkuerzt aus, daher getrennt geprueft
      WHILE p%>1 AND mw%:(LEFT$(s$,p%),t%)>avail% : p%=p%-1 : ENDWH
      RETURN p%
    ENDIF
  ENDIF
  p%=q%-1
  IF p%<1 : p%=1 : ENDIF
  REM zurueck, falls zu breit
  WHILE mw%:(LEFT$(s$,p%),t%)>avail%
    q%=lastsp%:(s$,p%)
    IF q%<=1
      WHILE p%>1 AND mw%:(LEFT$(s$,p%),t%)>avail% : p%=p%-1 : ENDWH
      RETURN p%
    ENDIF
    p%=q%-1
  ENDWH
  REM vor, solange das naechste Wort noch passt
  WHILE p%<n%
    q%=LOC(MID$(s$,p%+2,255)," ")
    IF q%=0 : q%=n% : ELSE : q%=p%+q% : ENDIF
    IF mw%:(LEFT$(s$,q%),t%)>avail% : BREAK : ENDIF
    p%=q%
  ENDWH
  RETURN p%
ENDP

PROC addln:(off&,n%,t%,ind%)
  IF ln%>=KMaxLn% : RETURN : ENDIF
  ln%=ln%+1
  lo&(ln%)=off& : ll%(ln%)=n% : lt%(ln%)=t% : lx%(ln%)=ind%
ENDP

REM Nur aus Zeichen c$ (mind. 3)?
PROC only%:(s$,c$)
  LOCAL i%
  IF LEN(s$)<3 : RETURN 0 : ENDIF
  i%=1
  WHILE i%<=LEN(s$)
    IF MID$(s$,i%,1)<>c$ : RETURN 0 : ENDIF
    i%=i%+1
  ENDWH
  RETURN -1
ENDP

REM Leerzeichen an beiden Enden entfernen
PROC trim$:(sp$)
  LOCAL s$(255)
  s$=sp$
  WHILE LEFT$(s$,1)=" " : s$=MID$(s$,2,255) : ENDWH
  WHILE RIGHT$(s$,1)=" " : s$=LEFT$(s$,LEN(s$)-1) : ENDWH
  RETURN s$
ENDP

REM Text auf avail% Pixel kuerzen, mit "..." (CP1252 133)
PROC trunc$:(s$,avail%,t%)
  LOCAL w%, p%
  w%=mw%:(s$,t%)
  IF w%<=avail% : RETURN s$ : ENDIF
  p%=INT(FLT(LEN(s$))*FLT(avail%)/FLT(w%))-1
  IF p%<1 : p%=1 : ENDIF
  WHILE p%>1 AND mw%:(LEFT$(s$,p%)+CHR$(133),t%)>avail% : p%=p%-1 : ENDWH
  RETURN LEFT$(s$,p%)+CHR$(133)
ENDP

REM Position des naechsten Zellentrenners | (0 = keiner); | innerhalb [[...]] zaehlt nicht
PROC cellend%:(s$)
  LOCAL p%, o%, c%, q%
  p%=LOC(s$,"|")
  WHILE p%>0
    o%=p%-1
    WHILE o%>0
      IF MID$(s$,o%,2)="[[" : BREAK : ENDIF
      o%=o%-1
    ENDWH
    IF o%=0 : RETURN p% : ENDIF
    IF LOC(MID$(s$,o%,p%-o%),"]]")>0 : RETURN p% : ENDIF
    c%=LOC(MID$(s$,p%+1,255),"]]")
    IF c%=0 : RETURN p% : ENDIF
    q%=LOC(MID$(s$,p%+c%+2,255),"|")
    IF q%=0 : RETURN 0 : ENDIF
    p%=p%+c%+1+q%
  ENDWH
  RETURN 0
ENDP

REM Tabellen-Trennzeile wie |---|:--:| ?
PROC tsep%:(s$)
  LOCAL i%, c$(1), dash%
  dash%=0
  i%=1
  WHILE i%<=LEN(s$)
    c$=MID$(s$,i%,1)
    IF c$="-" : dash%=-1
    ELSEIF c$<>"|" AND c$<>":" AND c$<>" " : RETURN 0
    ENDIF
    i%=i%+1
  ENDWH
  RETURN dash%
ENDP

REM Tabelle ab start& vorausscannen: Spaltenbreiten in tcw%, Spaltenzahl in tcn%.
REM Liefert die Tabellen-Nr. oder 0 (keine Zeilen / zu viele Tabellen -> Klartext).
PROC tabscan%:(start&)
  LOCAL pos&, s$(255), nl%, line$(255), id%, c%, n%, w%, cell$(255), rows%, b%
  IF tbn%>=KMaxTb% : RETURN 0 : ENDIF
  id%=tbn%+1 : b%=(id%-1)*KMaxTc%
  n%=1
  WHILE n%<=KMaxTc% : tcw%(b%+n%)=0 : n%=n%+1 : ENDWH
  tcn%(id%)=0
  pos&=start& : rows%=0
  setfont:(KTText%)
  WHILE pos&<bufsz& AND rows%<200
    s$=peekat$:(pos&,255)
    nl%=LOC(s$,CHR$(10))
    IF nl%>0 : line$=LEFT$(s$,nl%-1) : pos&=pos&+nl% : ELSE : line$=s$ : pos&=pos&+LEN(s$) : ENDIF
    IF RIGHT$(line$,1)=CHR$(13) : line$=LEFT$(line$,LEN(line$)-1) : ENDIF
    line$=trim$:(line$)
    IF LEFT$(line$,1)<>"|" : BREAK : ENDIF
    IF tsep%:(line$)=0
      rows%=rows%+1
      line$=MID$(line$,2,255)
      n%=0
      WHILE LEN(line$)>0 AND n%<KMaxTc%
        c%=cellend%:(line$)
        IF c%=0 : cell$=line$ : line$="" : ELSE : cell$=LEFT$(line$,c%-1) : line$=MID$(line$,c%+1,255) : ENDIF
        n%=n%+1
        w%=mw%:(trim$:(cell$),KTText%)
        IF rows%=1 : w%=w%+w%/7 : ENDIF
        w%=w%+12
        IF w%>KMaxColW% : w%=KMaxColW% : ENDIF
        IF w%>tcw%(b%+n%) : tcw%(b%+n%)=w% : ENDIF
      ENDWH
      IF n%>tcn%(id%) : tcn%(id%)=n% : ENDIF
    ENDIF
  ENDWH
  IF rows%=0 : RETURN 0 : ENDIF
  REM Zu breite Tabellen proportional auf die Bildschirmbreite stauchen (min. 50 px je Spalte)
  w%=0 : n%=1
  WHILE n%<=tcn%(id%) : w%=w%+tcw%(b%+n%) : n%=n%+1 : ENDWH
  c%=KScrW%-2*KMargin%-12
  IF w%>c%
    n%=1
    WHILE n%<=tcn%(id%)
      tcw%(b%+n%)=INT(FLT(tcw%(b%+n%))*FLT(c%)/FLT(w%))
      IF tcw%(b%+n%)<50 : tcw%(b%+n%)=50 : ENDIF
      n%=n%+1
    ENDWH
  ENDIF
  tbn%=id%
  RETURN id%
ENDP

REM Layout-Zustand zuruecksetzen; Sichtzeilen werden bei Bedarf mit laymore: berechnet
PROC layout:
  ln%=0 : lpos&=0 : lcont%=0 : lcode%=0 : lfm%=0 : ltyp%=KTText% : lind%=0
  ltab%=0 : lhdr%=0 : tbn%=0
ENDP

PROC laydone%:
  RETURN lpos&>=bufsz& OR ln%>=KMaxLn%
ENDP

REM Sichtzeilen berechnen, bis mindestens need% vorliegen (oder Dateiende)
PROC laymore:(need%)
  LOCAL pos&, s$(255), line$(255), nl%, full%, adv&, cont%, t%, ind%, incode%, infm%
  LOCAL skip%, lead%, off%, n%, avail%, w%, c$(1), p$(4)
  pos&=lpos& : cont%=lcont% : t%=ltyp% : ind%=lind% : incode%=lcode% : infm%=lfm%
  WHILE pos&<bufsz& AND ln%<KMaxLn% AND ln%<need%
    s$=peekat$:(pos&,255)
    nl%=LOC(s$,CHR$(10))
    IF nl%>0
      line$=LEFT$(s$,nl%-1) : full%=-1 : adv&=nl%
      IF RIGHT$(line$,1)=CHR$(13) : line$=LEFT$(line$,LEN(line$)-1) : ENDIF
    ELSEIF LEN(s$)<255
      line$=s$ : full%=-1 : adv&=LEN(s$)
    ELSE
      line$=s$ : full%=0 : adv&=0
    ENDIF
    skip%=0 : lead%=0
    IF cont%=0
      REM Zeilenanfang: Typ bestimmen
      IF pos&=0 AND line$="---"
        infm%=-1 : skip%=-1 : addln:(0,0,KTFront%,0)
      ELSEIF infm%
        skip%=-1
        IF line$="---" : infm%=0 : ENDIF
      ELSEIF LEFT$(line$,3)="```"
        incode%=NOT incode% : skip%=-1 : ltab%=0
      ELSEIF incode%
        t%=KTCode% : ind%=8
      ELSE
        t%=KTText% : ind%=0
        REM Einrueckung fuer Listen zaehlen
        WHILE lead%<LEN(line$)
          c$=MID$(line$,lead%+1,1)
          IF c$=" " : lead%=lead%+1
          ELSEIF c$=CHR$(9) : lead%=lead%+2
          ELSE : BREAK
          ENDIF
        ENDWH
        p$=MID$(line$,lead%+1,4)
        IF LEFT$(p$,1)="|"
          IF ltab%=0 : ltab%=tabscan%:(pos&) : lhdr%=-1 : ENDIF
          IF ltab%>0
            IF tsep%:(line$) : skip%=-1 : ELSE : t%=KTTable% : ind%=ltab%*4+(lhdr% AND 1) : lhdr%=0 : ENDIF
          ENDIF
        ELSE
          ltab%=0
        ENDIF
        IF t%=KTTable% OR skip%
        ELSEIF LEFT$(line$,4)="### " : t%=KTH3% : lead%=4
        ELSEIF LEFT$(line$,5)="#### " : t%=KTH3% : lead%=5
        ELSEIF LEFT$(line$,3)="## " : t%=KTH2% : lead%=3
        ELSEIF LEFT$(line$,2)="# " : t%=KTH1% : lead%=2
        ELSEIF LEFT$(p$,2)="- " OR LEFT$(p$,2)="* " OR LEFT$(p$,2)="+ "
          t%=KTList% : ind%=16+(lead%/2)*16 : lead%=lead%+2
        ELSEIF LEFT$(line$,2)="> "
          t%=KTQuote% : ind%=16 : lead%=2
        ELSEIF LEFT$(line$,1)=">" AND LEN(line$)=1
          t%=KTQuote% : ind%=16 : lead%=1
        ELSEIF only%:(line$,"-") OR only%:(line$,"*") OR only%:(line$,"_")
          t%=KTRule% : skip%=-1 : addln:(pos&,0,KTRule%,0)
        ELSEIF LEN(p$)>=3
          c$=LEFT$(p$,1)
          IF c$>="0" AND c$<="9" AND (MID$(p$,2,2)=". " OR MID$(p$,3,2)=". ")
            t%=KTListC% : ind%=16+(lead%/2)*16
          ENDIF
        ENDIF
      ENDIF
    ENDIF
    IF skip%
      IF full% : pos&=pos&+adv& : ELSE : pos&=eol&:(pos&) : ENDIF
      cont%=0
      CONTINUE
    ENDIF
    IF t%=KTTable%
      REM Tabellenzeile ungebrochen uebernehmen
      addln:(pos&+lead%,LEN(line$)-lead%,KTTable%,ind%)
      IF full% : pos&=pos&+adv& : ELSE : pos&=pos&+LEN(line$) : ENDIF
      cont%=0
      CONTINUE
    ENDIF
    REM Text ab lead% in Sichtzeilen umbrechen
    setfont:(t%)
    avail%=KScrW%-2*KMargin%-ind%-24
    off%=lead%
    line$=MID$(line$,lead%+1,255)
    IF LEN(line$)=0 AND full%
      addln:(pos&,0,KTText%,0)
    ENDIF
    WHILE LEN(line$)>0
      n%=fit%:(line$,avail%,t%)
      IF full%=0 AND n%=LEN(line$) AND off%>0
        REM Rest koennte Teil eines laengeren Worts sein: neu einlesen
        BREAK
      ENDIF
      addln:(pos&+off%,n%,t%,ind%)
      IF t%=KTList% : t%=KTListC% : ENDIF
      off%=off%+n%
      line$=MID$(line$,n%+1,255)
      WHILE LEFT$(line$,1)=" " : line$=MID$(line$,2,255) : off%=off%+1 : ENDWH
      IF full%=0 AND LEN(line$)<130 : BREAK : ENDIF
    ENDWH
    IF full%
      pos&=pos&+adv& : cont%=0
    ELSE
      pos&=pos&+off% : cont%=-1
    ENDIF
  ENDWH
  lpos&=pos& : lcont%=cont% : ltyp%=t% : lind%=ind% : lcode%=incode% : lfm%=infm%
  gSTYLE 0
ENDP

REM ---------------------------------------------------------------- Viewer

REM Zeile mit Inline-Auszeichnung zeichnen; y% = Grundlinie, top% = Zeilenoberkante
PROC drawinl:(sp$,x%,y%,top%,h%,t%)
  LOCAL pb%, pc%, pl%, p%, kind%, bold%, code%, e%, in$(255), disp$(255), bar%, sty%, s$(255)
  s$=sp$
  bold%=0 : code%=0
  gAT x%,y%
  WHILE LEN(s$)>0
    pb%=LOC(s$,"**") : pc%=LOC(s$,"`") : pl%=LOC(s$,"[[")
    p%=0 : kind%=0
    IF pb%>0 : p%=pb% : kind%=1 : ENDIF
    IF pc%>0 AND (p%=0 OR pc%<p%) : p%=pc% : kind%=2 : ENDIF
    IF pl%>0 AND (p%=0 OR pl%<p%) : p%=pl% : kind%=3 : ENDIF
    IF p%=0 : gPRINT s$ : BREAK : ENDIF
    IF p%>1 : gPRINT LEFT$(s$,p%-1) : ENDIF
    IF kind%=1
      bold%=NOT bold%
      IF bold% : gSTYLE 1 : ELSE : gSTYLE 0 : ENDIF
      s$=MID$(s$,p%+2,255)
    ELSEIF kind%=2
      code%=NOT code%
      IF code% : gFONT courier&:(fsize%:(KTText%)) : ELSE : setfont:(t%) : ENDIF
      IF bold% : gSTYLE 1 : ENDIF
      s$=MID$(s$,p%+1,255)
    ELSE
      e%=LOC(MID$(s$,p%+2,255),"]]")
      IF e%=0
        gPRINT s$ : BREAK
      ENDIF
      e%=p%+1+e%
      in$=MID$(s$,p%+2,e%-p%-2)
      bar%=LOC(in$,"|")
      IF bar%>0 : disp$=MID$(in$,bar%+1,255) : ELSE : disp$=in$ : ENDIF
      IF lkn%<KMaxLk%
        lkn%=lkn%+1
        lk$(lkn%)=LEFT$(in$,120)
        lkx%(lkn%)=gX : lky%(lkn%)=top% : lkw%(lkn%)=gTWIDTH(disp$) : lkh%(lkn%)=h%
      ENDIF
      sty%=2
      IF bold% : sty%=3 : ENDIF
      gSTYLE sty%
      gPRINT disp$
      IF bold% : gSTYLE 1 : ELSE : gSTYLE 0 : ENDIF
      IF lkn%=lksel% : gAT lkx%(lkn%)-2,top% : gFILL lkw%(lkn%)+4,h%,2 : gAT lkx%(lkn%)+lkw%(lkn%),y% : ENDIF
      s$=MID$(s$,e%+2,255)
    ENDIF
  ENDWH
  gSTYLE 0
ENDP

REM Tabellenzeile: Zellen an den vorab gemessenen Spaltenbreiten, Kopfzeile fett
PROC drawtr:(i%,y%)
  LOCAL id%, hdr%, b%, line$(255), cell$(255), c%, n%, x%, cw%
  id%=lx%(i%)/4 : hdr%=lx%(i%) AND 1 : b%=(id%-1)*KMaxTc%
  line$=trim$:(peekat$:(lo&(i%),ll%(i%)))
  IF LEFT$(line$,1)="|" : line$=MID$(line$,2,255) : ENDIF
  x%=KMargin% : n%=0
  WHILE LEN(line$)>0 AND n%<tcn%(id%)
    c%=cellend%:(line$)
    IF c%=0 : cell$=line$ : line$="" : ELSE : cell$=LEFT$(line$,c%-1) : line$=MID$(line$,c%+1,255) : ENDIF
    n%=n%+1 : cw%=tcw%(b%+n%)
    IF x%+cw%>KScrW%-10 : BREAK : ENDIF
    cell$=trunc$:(trim$:(cell$),cw%-8,KTText%)
    IF hdr%
      setfont:(KTText%) : gSTYLE 1 : gAT x%+4,y%+ascent%:(KTText%) : gPRINT cell$ : gSTYLE 0
    ELSE
      setfont:(KTText%) : drawinl:(cell$,x%+4,y%+ascent%:(KTText%),y%,lineh%:(KTText%,1),KTText%)
    ENDIF
    x%=x%+cw%
    gAT x%-1,y% : gFILL 1,lineh%:(KTText%,1),0
  ENDWH
  IF hdr% : gAT KMargin%,y%+lineh%:(KTText%,1)-1 : gFILL x%-KMargin%,1,0 : ENDIF
ENDP

PROC drawln:(i%,y%)
  LOCAL s$(255), t%, x%, h%, b%
  t%=lt%(i%)
  h%=lineh%:(t%,ll%(i%))
  x%=KMargin%+lx%(i%)
  IF t%=KTTable%
    drawtr:(i%,y%)
    RETURN
  ENDIF
  IF t%=KTRule%
    gAT KMargin%,y%+4 : gFILL KScrW%-2*KMargin%-16,1,0
    RETURN
  ENDIF
  setfont:(t%)
  b%=y%+ascent%:(t%)
  IF t%=KTFront%
    gSTYLE 0 : gAT x%,b% : gPRINT "[Frontmatter]"
    RETURN
  ENDIF
  IF ll%(i%)=0 : RETURN : ENDIF
  s$=peekat$:(lo&(i%),ll%(i%))
  IF t%=KTList% : gAT x%-11,b% : gPRINT CHR$(149) : ENDIF
  IF t%=KTQuote% : gAT x%-10,y% : gFILL 2,h%,0 : ENDIF
  IF t%=KTCode%
    gAT x%,b% : gPRINT s$
    RETURN
  ENDIF
  drawinl:(s$,x%,b%,y%,h%,t%)
ENDP

PROC drawpage:(f$)
  LOCAL i%, y%, h%, sb%, sy%, sh%
  gUPDATE OFF
  gCLS
  title2:(base$:(f$),meta$)
  lkn%=0
  laymore:(vtop%+30)
  i%=vtop% : y%=KTitleH%+3 : vpage%=0
  WHILE i%<=ln%
    h%=lineh%:(lt%(i%),ll%(i%))
    IF y%+h%>KScrH% : BREAK : ENDIF
    drawln:(i%,y%)
    y%=y%+h% : i%=i%+1 : vpage%=vpage%+1
  ENDWH
  IF vpage%<1 : vpage%=1 : ENDIF
  REM Scrollbalken rechts, nach Byte-Position (Layout ist evtl. noch unvollstaendig)
  IF bufsz&>0 AND ln%>0 AND (vtop%>1 OR i%<=ln% OR NOT laydone%:)
    sb%=KScrH%-KTitleH%-2
    sy%=KTitleH%+1+INT(FLT(sb%)*FLT(lo&(vtop%))/FLT(bufsz&))
    IF i%<=ln% : sh%=INT(FLT(sb%)*FLT(lo&(i%)-lo&(vtop%))/FLT(bufsz&)) : ELSE : sh%=KTitleH%+1+sb%-sy% : ENDIF
    IF sh%<6 : sh%=6 : ENDIF
    gAT KScrW%-6,KTitleH%+1 : gFILL 1,sb%,0
    gAT KScrW%-8,sy% : gFILL 5,sh%,0
  ENDIF
  gSTYLE 0
  gUPDATE ON
  gUPDATE
ENDP

REM Erste Zeile der letzten Seite (rueckwaerts nach Zeilenhoehen)
PROC lastpg%:
  LOCAL i%, y%
  i%=ln% : y%=0
  WHILE i%>=1
    y%=y%+lineh%:(lt%(i%),ll%(i%))
    IF y%>KScrH%-KTitleH%-3 : RETURN i%+1 : ENDIF
    i%=i%-1
  ENDWH
  RETURN 1
ENDP

PROC open%:(f$)
  LOCAL r%
  BUSY "Lade..."
  r%=load%:(f$)
  IF r%<0
    BUSY OFF
    ALERT("Notiz kann nicht gelesen werden",ERR$(r%))
    RETURN r%
  ENDIF
  layout:
  mkmeta:(0)
  BUSY OFF
  RETURN 0
ENDP

PROC view:(fp$)
  LOCAL k%, t$(120), f$(120), i%, dirty%, skip%
  f$=fp$
  bkn%=0 : lksel%=0
  IF open%:(f$)<0 : RETURN : ENDIF
  vtop%=1 : dirty%=-1 : skip%=0
  WHILE 1
    IF autoed%
      REM frisch angelegte Notiz: direkt bearbeiten
      autoed%=0 : editnote:(f$)
    ENDIF
    IF dirty%
      IF skip%>=4 OR NOT TESTEVENT
        drawpage:(f$) : dirty%=0 : skip%=0
      ELSE
        skip%=skip%+1
      ENDIF
    ENDIF
    k%=evkey%:
    IF k%=0 : CONTINUE : ENDIF
    dirty%=-1
    IF k%=-1
      REM Stift: Titelzeile = schliessen, Link = folgen, obere/untere Haelfte = blaettern
      k%=0
      IF peny%<KTitleH%
        k%=KKeyEsc%
      ELSE
        i%=1
        WHILE i%<=lkn%
          IF penx%>=lkx%(i%)-2 AND penx%<=lkx%(i%)+lkw%(i%)+2 AND peny%>=lky%(i%) AND peny%<lky%(i%)+lkh%(i%)
            lksel%=i% : k%=KKeyEnter% : BREAK
          ENDIF
          i%=i%+1
        ENDWH
        IF k%=0
          IF peny%<KScrH%/2 : k%=KKeyPageUp% : ELSE : k%=KKeyPageDown% : ENDIF
        ENDIF
      ENDIF
    ENDIF
    IF k%=KCtrlE%
      quit:
    ELSEIF k%=KCtrlW%
      RETURN
    ELSEIF k%=%e OR k%=%E OR k%=%b OR k%=%B
      editnote:(f$)
    ELSEIF k%=KKeyDownArrow% : vtop%=vtop%+1 : lksel%=0
    ELSEIF k%=KKeyUpArrow% : vtop%=vtop%-1 : lksel%=0
    ELSEIF k%=KKeyPageDown% OR k%=KKeySpace% : vtop%=vtop%+vpage%-1 : lksel%=0
    ELSEIF k%=KKeyPageUp% : vtop%=vtop%-vpage%+1 : lksel%=0
    ELSEIF k%=KKeyPageLeft% : vtop%=1 : lksel%=0
    ELSEIF k%=KKeyPageRight%
      BUSY "Layout..." : laymore:(KMaxLn%) : BUSY OFF
      vtop%=lastpg%: : lksel%=0
    ELSEIF k%=KKeyTab%
      IF lkn%>0 : lksel%=lksel%+1 : IF lksel%>lkn% : lksel%=1 : ENDIF : ENDIF
    ELSEIF k%=KKeyEnter%
      IF lksel%>0 AND lksel%<=lkn%
        t$=resolve$:(lk$(lksel%))
        IF t$=""
          ALERT("Notiz nicht gefunden",lk$(lksel%))
        ELSE
          IF bkn%<KMaxBk% : bkn%=bkn%+1 : bk$(bkn%)=f$ : bkt%(bkn%)=vtop% : ENDIF
          IF open%:(t$)=0 : f$=t$ : vtop%=1 : lksel%=0 : ELSE : bkn%=bkn%-1 : ENDIF
        ENDIF
      ENDIF
    ELSEIF k%=KKeyEsc% OR k%=KKeyDel% OR k%=KKeyLeftArrow%
      IF bkn%>0
        f$=bk$(bkn%) : vtop%=bkt%(bkn%) : bkn%=bkn%-1 : lksel%=0
        IF open%:(f$)<0 : RETURN : ENDIF
      ELSE
        RETURN
      ENDIF
    ELSEIF k%=KCtrlF% OR k%=KCtrlN%
      IF k%=KCtrlF% : t$=search$: : ELSE : t$=newnote$: : ENDIF
      IF t$<>""
        IF bkn%<KMaxBk% : bkn%=bkn%+1 : bk$(bkn%)=f$ : bkt%(bkn%)=vtop% : ENDIF
        f$=t$ : vtop%=1 : lksel%=0
      ENDIF
      IF open%:(f$)<0 : RETURN : ENDIF
    ELSEIF k%=KCtrlD%
      IF delnote%:(f$) : RETURN : ENDIF
    ELSEIF k%=KZoomIn% OR k%=43
      setzoom:(zoom%+1)
    ELSEIF k%=KZoomOut% OR k%=45
      setzoom:(zoom%-1)
    ELSEIF k%=KGetMenu%
      k%=menu%:(-1)
      IF k%=%i : setzoom:(zoom%+1) : ENDIF
      IF k%=%k : setzoom:(zoom%-1) : ENDIF
      IF k%=%e : quit: : ENDIF
      IF k%=%w : RETURN : ENDIF
      IF k%=%b : editnote:(f$) : ENDIF
      IF k%=%r : bldidx: : ENDIF
      IF k%=%d
        IF delnote%:(f$) : RETURN : ENDIF
      ENDIF
      IF k%=%f OR k%=%n
        IF k%=%f : t$=search$: : ELSE : t$=newnote$: : ENDIF
        IF t$<>""
          IF bkn%<KMaxBk% : bkn%=bkn%+1 : bk$(bkn%)=f$ : bkt%(bkn%)=vtop% : ENDIF
          f$=t$ : vtop%=1 : lksel%=0
        ENDIF
        IF open%:(f$)<0 : RETURN : ENDIF
      ENDIF
    ENDIF
    IF vtop%<1 : vtop%=1 : ENDIF
    laymore:(vtop%+vpage%)
    IF laydone%:
      IF vtop%>lastpg%: : vtop%=lastpg%: : ENDIF
    ELSEIF vtop%>ln%
      vtop%=ln%
    ENDIF
    IF vtop%<1 : vtop%=1 : ENDIF
  ENDWH
ENDP
